{
  "name": "playwright-chaos-recipes",
  "version": "0.2.0",
  "description": "Deterministic chaos experiments for Playwright",
  "type": "module",
  "license": "MIT",
  "author": "Deepak Koul <kouldeep@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkoul/pw-chaos.git"
  },
  "homepage": "https://github.com/dkoul/pw-chaos#readme",
  "bugs": "https://github.com/dkoul/pw-chaos/issues",
  "keywords": [
    "playwright",
    "testing",
    "chaos-engineering",
    "resilience",
    "e2e",
    "failure-injection"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && playwright test",
    "test:ui": "playwright test --ui",
    "demo": "vite --host 127.0.0.1",
    "demo:build": "vite build",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5"
  }
}